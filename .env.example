# Broker: meritz (default) or toss (read-only client only; further work is deferred)
BROKER=meritz

# Meritz Open API (openapi.imeritz.com > API 신청 > 신청현황). Keys are issued per account.
MERITZ_APP_KEY=
MERITZ_APP_SECRET=
# 12 hex chars sent as the required mac_address header; auto-detected when empty
MERITZ_MAC_ADDRESS=

# Toss Securities Open API (WTS > 설정 > Open API), only when BROKER=toss
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=
# optional; defaults to the first account from /api/v1/accounts
TOSS_ACCOUNT_SEQ=

# Bot (dry-run only for now; DRY_RUN=false is refused)
# KR: 6-digit code (005930). US on meritz: SYMBOL.EXCHANGE (AAPL.OQ; OQ Nasdaq, NY NYSE, AX Amex)
DRY_RUN=true
SYMBOLS=005930
STRATEGY=sma
SMA_SHORT=5
SMA_LONG=20
POLL_SECONDS=10
# KRW budget per buy; USD symbols are converted with the live USD/KRW rate
ORDER_BUDGET_KRW=100000
MAX_ORDER_KRW=200000
# buys stop once today's realized + unrealized P&L <= -MAX_DAILY_LOSS_KRW
MAX_DAILY_LOSS_KRW=50000
MAX_ORDERS_PER_DAY=10
DB_PATH=data/bot.sqlite3
# this file existing stops all trading (dashboard toggle, or `touch data/KILL`)
KILL_SWITCH_PATH=data/KILL

# Dashboard (docker compose). Set a password before exposing it beyond localhost,
# e.g. DASHBOARD_BIND=0.0.0.0 to open it to the home LAN.
DASHBOARD_PASSWORD=
DASHBOARD_BIND=127.0.0.1
